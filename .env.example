# ==========================================
# IRON MAN SUIT - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Provider Configuration
# Supported options: 'demo' (zero-config simulated JARVIS) | 'openai'
AI_PROVIDER=demo
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# External Weather API (Optional - automatically uses mock telemetry if blank)
OPENWEATHER_API_KEY=
DEFAULT_CITY=New York

# Suit Simulation Settings
ENABLE_HARDWARE_SIMULATION=true
TELEMETRY_INTERVAL_MS=1500
