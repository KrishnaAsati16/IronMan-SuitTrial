PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Provider: 'demo' or 'openai'
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Weather API
OPENWEATHER_API_KEY=
DEFAULT_CITY=Malibu

# Hardware Simulation
ENABLE_HARDWARE_SIMULATION=true
TELEMETRY_INTERVAL_MS=1500
