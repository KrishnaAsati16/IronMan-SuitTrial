{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@ai/*": ["../ai/*"]
    }
  },
  "include": [
    "src/**/*",
    "../ai/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
